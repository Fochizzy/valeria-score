{
  "expo": {
    "name": "Valeria Score",
    "slug": "valeria-score",
    "scheme": "valeriascore",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0F1E",
    "icon": "./assets/icon.png",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/65d3d590-35be-49f3-9faa-0440a3851d62"
    },
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0F1E"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.fochizzy87.valeriascore",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A0F1E"
      }
    },
    "ios": {
      "bundleIdentifier": "com.fochizzy.valeriascore",
      "buildNumber": "1",
      "icon": "./assets/icon.png"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "65d3d590-35be-49f3-9faa-0440a3851d62"
      }
    }
  }
}
